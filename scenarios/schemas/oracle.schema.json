{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibn-eval.example/schemas/oracle.schema.json",
  "title": "IBN experimental oracle",
  "type": "object",
  "required": [
    "schema_version",
    "oracle_id",
    "version",
    "domain",
    "phase",
    "success"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "oracle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "connectivity",
        "dhcp_dns",
        "filtering",
        "qos",
        "security",
        "vlan",
        "combined"
      ]
    },
    "phase": {
      "enum": [
        "healthy",
        "expected_degradation",
        "repair",
        "preservation"
      ]
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "compose": {
      "description": "Assemble the probes from the oracles of the components named in bindings.components: each component's oracle for this phase, resolved with that component's bindings, becomes one group. affected_nodes 'union' resolves every component with the union of the blast radii instead of its own.",
      "type": "object",
      "required": [
        "affected_nodes"
      ],
      "properties": {
        "affected_nodes": {
          "enum": [
            "component",
            "union"
          ]
        }
      },
      "additionalProperties": false
    },
    "success": {
      "$ref": "#/$defs/success"
    }
  },
  "$defs": {
    "endpoint": {
      "type": [
        "string",
        "integer"
      ]
    },
    "probe": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "destination",
        "protocol",
        "attempts",
        "timeout_seconds",
        "metrics",
        "thresholds",
        "aggregation",
        "success"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "type": {
          "enum": [
            "icmp",
            "tcp",
            "dns",
            "http",
            "throughput",
            "connectivity_matrix",
            "isolation_matrix",
            "security_event",
            "configuration"
          ]
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "destination": {
          "$ref": "#/$defs/endpoint"
        },
        "protocol": {
          "enum": [
            "icmp",
            "tcp",
            "udp",
            "dns",
            "http",
            "https",
            "config"
          ]
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "$ref": "#/$defs/binding_ref"
            }
          ]
        },
        "scope": {
          "enum": [
            "all",
            "affected",
            "unaffected"
          ]
        },
        "affected_nodes": {
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "string",
              "pattern": "^\\$\\{bindings\\.[a-zA-Z0-9_]+\\}$"
            }
          ]
        },
        "paths": {
          "description": "The paths a matrix probe with destination bound_paths measures, as 'source->destination', usually bound from the scenario: a change request is judged on the reachability it asks for, not on the topology's own requirements.",
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[^\\s>]+->[^\\s>]+$"
              }
            },
            {
              "$ref": "#/$defs/binding_ref"
            }
          ]
        },
        "addressing": {
          "description": "Which addresses a bound_paths probe pings: the one the descriptor declares for the destination, or every data-plane address it holds when measured (live), for hosts the subject was asked to re-address.",
          "enum": [
            "declared",
            "live"
          ]
        },
        "ports": {
          "description": "A tcp isolation_matrix over bound_paths: test every TCP port the destination listens on when measured (listening), save those open_services keeps open. A port nothing listens on is refused whether a firewall is in the way or not, so only listening ports can show a rule opened too wide.",
          "enum": [
            "listening"
          ]
        },
        "open_services": {
          "description": "The 'node:port' a tcp isolation_matrix leaves out of its ports: the services the change is meant to open.",
          "oneOf": [
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[^\\s:]+:[0-9]+$"
              }
            },
            {
              "$ref": "#/$defs/binding_ref"
            }
          ]
        },
        "ttl": {
          "description": "Time to live of a bound_paths connectivity probe's packets. At 1 only a destination in the source's own broadcast domain answers: a router on the way drops the packet.",
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "success",
              "packet_loss_percent",
              "rtt_min_ms",
              "rtt_avg_ms",
              "rtt_max_ms",
              "throughput_mbps",
              "jitter_ms",
              "http_status",
              "answer_count",
              "event_count",
              "configuration_match",
              "total_checks",
              "passed_checks",
              "failed_checks",
              "blocked_checks",
              "leaked_checks",
              "timed_out",
              "circuit_egress_mbps"
            ]
          }
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/threshold"
          }
        },
        "aggregation": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "all_attempts",
                "any_attempt",
                "mean",
                "minimum",
                "maximum",
                "percentile"
              ]
            },
            "percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "percentile"
                  }
                }
              },
              "then": {
                "required": [
                  "percentile"
                ]
              }
            }
          ],
          "additionalProperties": false
        },
        "success": {
          "$ref": "#/$defs/success"
        },
        "measurement": {
          "type": "object",
          "description": "Inputs a throughput probe needs beyond source and destination, including whether the oracle offers the competing flow itself. A family whose fault is already the flood declares contended: false -- starting a second one would distort it, and stopping it would remove what is being measured.",
          "required": [
            "protected_source",
            "sink_ip",
            "measurement_port",
            "destination",
            "destination_ip",
            "assured_bandwidth_mbps",
            "seconds",
            "contended"
          ],
          "properties": {
            "protected_source": {
              "type": "string",
              "minLength": 1
            },
            "sink_ip": {
              "type": "string",
              "minLength": 1
            },
            "measurement_port": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/binding_ref"
                }
              ]
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "background_source": {
              "type": "string",
              "minLength": 1
            },
            "load_port": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/binding_ref"
                }
              ]
            },
            "link_mbps": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/binding_ref"
                }
              ]
            },
            "wan_edge": {
              "type": "string",
              "minLength": 1,
              "description": "Node that shapes the circuit. With shaped_interface, the probe reads that interface's transmitted bytes around the sample and reports circuit_egress_mbps, so a repair that removed or widened the circuit shows up as egress above the link rate."
            },
            "shaped_interface": {
              "type": "string",
              "minLength": 1
            },
            "destination": {
              "type": "string",
              "minLength": 1
            },
            "destination_ip": {
              "type": "string",
              "minLength": 1
            },
            "assured_bandwidth_mbps": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "$ref": "#/$defs/binding_ref"
                }
              ]
            },
            "contended": {
              "type": "boolean"
            },
            "fault_flood": {
              "type": "boolean",
              "description": "The phase is measured under the fault's own flood, from background_source. The probe neither starts nor stops it, but looks for it before and after the sample, and a sample it did not cover reports no throughput_mbps: a flood with a fixed duration can end before the episode does, and an untouched network then passes. Only with contended: false."
            }
          },
          "dependentRequired": {
            "wan_edge": [
              "shaped_interface"
            ],
            "shaped_interface": [
              "wan_edge"
            ],
            "fault_flood": [
              "background_source"
            ]
          },
          "additionalProperties": false
        },
        "groups": {
          "description": "The groups of an all_groups oracle this probe counts for.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "dependentRequired": {
        "paths": [
          "destination"
        ],
        "addressing": [
          "paths"
        ],
        "ttl": [
          "paths"
        ],
        "ports": [
          "paths"
        ],
        "open_services": [
          "paths"
        ]
      },
      "if": {
        "properties": {
          "destination": {
            "const": "bound_paths"
          }
        },
        "required": [
          "destination"
        ]
      },
      "then": {
        "required": [
          "paths"
        ],
        "properties": {
          "type": {
            "enum": [
              "connectivity_matrix",
              "isolation_matrix"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "required": [
        "metric",
        "operator"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "lt",
            "lte",
            "eq",
            "ne",
            "gte",
            "gt"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": [
                "number",
                "integer",
                "boolean"
              ]
            },
            {
              "$ref": "#/$defs/binding_ref"
            }
          ]
        },
        "baseline": {
          "type": "object",
          "required": [
            "metric",
            "factor"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "factor": {
              "type": "number",
              "minimum": 0
            },
            "offset": {
              "type": "number",
              "default": 0
            }
          },
          "additionalProperties": false
        },
        "combine": {
          "enum": [
            "min",
            "max"
          ]
        },
        "factor": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "offset": {
          "type": "number",
          "default": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "baseline"
            ]
          }
        },
        {
          "required": [
            "baseline"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "required": [
            "value",
            "baseline",
            "combine"
          ]
        }
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all",
            "any",
            "minimum_pass_rate",
            "all_groups"
          ]
        },
        "minimum_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "groups": {
          "description": "all_groups: each group's own success rule, over the probes that name the group. The oracle passes when every group does.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/success"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "minimum_pass_rate"
              }
            }
          },
          "then": {
            "required": [
              "minimum_pass_rate"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "binding_ref": {
      "type": "string",
      "pattern": "^\\$\\{bindings\\.[a-zA-Z0-9_]+\\}$"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "probes"
      ],
      "not": {
        "required": [
          "compose"
        ]
      }
    },
    {
      "required": [
        "compose"
      ],
      "not": {
        "required": [
          "probes"
        ]
      },
      "properties": {
        "domain": {
          "const": "combined"
        },
        "success": {
          "properties": {
            "mode": {
              "const": "all_groups"
            }
          }
        }
      }
    }
  ]
}
