// Authoritative zone for the DMZ services. dns-access-4 conditionally forwards
// *.dmz.lab here (see ../access/named.conf.local), so these records are what
// the LAN resolves for DMZ services.
zone "dmz.lab" {
	type master;
	file "/etc/bind/db.dmz.lab";
	allow-query { any; };
	allow-transfer { none; };
	allow-update { none; };
};
