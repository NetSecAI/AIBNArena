options {
    directory "/var/cache/bind";

    // Resolver for the internal zones. Only the enterprise ranges may query it.
    recursion yes;
    allow-query { 10.10.0.0/16; localhost; };
    allow-recursion { 10.10.0.0/16; localhost; };

    dnssec-validation no;
    listen-on { any; };
    listen-on-v6 { none; };
};
