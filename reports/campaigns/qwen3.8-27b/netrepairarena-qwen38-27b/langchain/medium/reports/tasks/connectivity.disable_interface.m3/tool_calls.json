              "edit network-instance default static-routes",
              "route 10.10.10.0/24 { admin-state enable next-hop-group to-leaf1 }",
              "route 10.10.20.0/24 { admin-state enable next-hop-group to-leaf1 }",
              "route 10.10.99.0/24 { admin-state enable next-hop-group to-leaf1 }",
              "next-hop-groups group to-leaf1 { nexthop 1 { ip-address 10.255.0.4 admin-state enable } nexthop 2 { ip-address 10.255.0.6 admin-state enable } }"
            ],
            "target": "leaf2"
          }
        ]
