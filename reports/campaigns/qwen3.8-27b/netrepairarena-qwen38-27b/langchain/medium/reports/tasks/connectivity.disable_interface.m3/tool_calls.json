    {
      "arguments": {
        "changes": [
          {
            "commands": [
              "edit network-instance default static-routes",
              "no route 10.10.10.0/24",
              "no route 10.10.20.0/24",
              "no route 10.10.99.0/24",
              "no next-hop-groups group to-leaf1"
            ],
            "reason": "leaf2 forwards guest_vlan (10.10.20.0/24) traffic to the spine, but the spine has no route back to leaf2's guest-facing path except via its leaf1-facing interfaces; with the spine's to-leaf1 next-hops pointing at leaf1 addresses, guest->dmz traffic loops through the spine and is dropped. Removing leaf2's redundant static routes makes 10.10.20.0/24 local to leaf1, so web1's reply for guest1 is delivered by leaf2 locally and guest1's traffic no longer loops via the spine.",
